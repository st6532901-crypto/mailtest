# ---- Required -------------------------------------------------------------
# Resend -> Webhooks -> your endpoint -> Signing Secret (starts with whsec_).
# Used to verify that incoming webhooks really come from Resend.
RESEND_WEBHOOK_SECRET=whsec_replace_me

# ---- Strongly recommended on Vercel ---------------------------------------
# Resend -> API Keys -> Create API Key (Full access).
# Lets the dashboard read received mail from Resend's Receiving API. Without it
# the dashboard only sees webhook events held in one server instance's memory,
# which is unreliable on serverless. Server-side only; never sent to the browser.
RESEND_API_KEY=re_replace_me

# ---- Optional -------------------------------------------------------------
# LOG_LEVEL=INFO
# Max allowed clock difference (seconds) between Resend and this server.
# WEBHOOK_TOLERANCE_SECONDS=300
